  "formal_definitions": [
    {
      "id": "D1",
      "name": "CSR Record",
      "statement": "csr = (csr_id, artifact_hash, semantic_id, layer, language, content, semantic_role, requirements_refs, assumptions, relations, version, provenance)",
      "status": "defined"
    },
    {
      "id": "D2",
      "name": "Semantic Relation",
      "statement": "Seven typed relations: refines, instantiates, approximates, implies, contradicts, depends_on, supersedes",
      "status": "defined"
    },
    {
      "id": "D3",
      "name": "Translation Classification",
      "statement": "Two orthogonal axes: Axis A (Semantic Relationship), Axis B (Verification Property)",
      "status": "defined"
    },
    {
      "id": "D4",
      "name": "Proof Obligation",
      "statement": "O = (id, property, assumptions, source_csr, discharged_by, verdict)",
      "status": "defined"
    },
    {
      "id": "D5",
      "name": "Proof Dependency Graph (PDG)",
      "statement": "PDG = (Obligations ∪ Evidence ∪ Assumptions, Edges)",
      "status": "defined"
    },
    {
      "id": "D6",
      "name": "Counterexample",
      "statement": "C = (id, obligation, witness, refutation_evidence, type, provenance)",
      "status": "defined"
    }
  ],
